# Copy to apps/mobile/.env (Expo only reads env files inside apps/mobile)
# Backend API base URL (no trailing slash). Detected production default:
# https://se-project-express-5lx6.onrender.com
EXPO_PUBLIC_API_URL=https://se-project-express-5lx6.onrender.com

# OpenWeatherMap API key (https://openweathermap.org/api)
EXPO_PUBLIC_WEATHER_API_KEY=your_openweathermap_key_here
