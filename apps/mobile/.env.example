# Backend API base URL (no trailing slash). Production default detected from
# the live WTWR web app; override per environment as needed.
EXPO_PUBLIC_API_URL=https://se-project-express-5lx6.onrender.com

# OpenWeatherMap API key — https://openweathermap.org/api
EXPO_PUBLIC_WEATHER_API_KEY=your_openweathermap_key_here

# RevenueCat public SDK keys — https://app.revenuecat.com
# (public keys are safe to ship in the app bundle; the secret stays on the server)
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=your_revenuecat_apple_key_here
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=your_revenuecat_google_key_here
