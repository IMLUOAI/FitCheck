diff --git a/models/battle.js b/models/battle.js
new file mode 100644
index 0000000..4a85314
--- /dev/null
+++ b/models/battle.js
@@ -0,0 +1,47 @@
+const mongoose = require("mongoose");
+
+const { ObjectId } = mongoose.Schema.Types;
+
+const battleSchema = new mongoose.Schema({
+  fitA: {
+    type: ObjectId,
+    ref: "Fit",
+    required: true,
+  },
+  fitB: {
+    type: ObjectId,
+    ref: "Fit",
+    required: true,
+  },
+  createdBy: {
+    type: ObjectId,
+    ref: "User",
+    required: true,
+  },
+  votesA: {
+    type: Number,
+    default: 0,
+  },
+  votesB: {
+    type: Number,
+    default: 0,
+  },
+  voters: [
+    {
+      type: ObjectId,
+      ref: "User",
+      default: [],
+    },
+  ],
+  status: {
+    type: String,
+    enum: ["open", "closed"],
+    default: "open",
+  },
+  createdAt: {
+    type: Date,
+    default: Date.now,
+  },
+});
+
+module.exports = mongoose.model("Battle", battleSchema);
